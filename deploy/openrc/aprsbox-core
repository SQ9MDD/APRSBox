#!/sbin/openrc-run

name="APRSBox Core"
description="APRSBox APRS core service"
command="/opt/aprsbox/venv/bin/python"
command_args="-m gunicorn --bind 127.0.0.1:18081 --workers 1 --worker-class uvicorn.workers.UvicornWorker --access-logfile - --error-logfile - app.core_main:app"
command_user="aprsbox:aprsbox"
directory="/opt/aprsbox/app"
pidfile="/run/aprsbox-core.pid"
command_background="yes"
output_log="/opt/aprsbox/logs/aprsbox-core.log"
error_log="/opt/aprsbox/logs/aprsbox-core.error.log"
retry="TERM/30/KILL/5"

export APRSBOX_ENV="production"
export APRSBOX_INSTALL_ROOT="/opt/aprsbox"
export APRSBOX_DB_PATH="/opt/aprsbox/data/aprsbox.db"
export APRSBOX_LOG_DIR="/opt/aprsbox/logs"
export PYTHONPATH="/opt/aprsbox/app"
export APRSBOX_PRIVILEGED_RUNNER="doas -n"
export APRSBOX_CORE_HOST="127.0.0.1"
export APRSBOX_CORE_PORT="18081"

depend() {
    need localmount
    use net
}
