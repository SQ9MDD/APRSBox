#!/sbin/openrc-run

name="APRSBox Web"
description="APRSBox FastAPI web GUI"
command="/opt/aprsbox/venv/bin/gunicorn"
command_args="--bind 0.0.0.0:8000 --workers 1 --worker-class uvicorn.workers.UvicornWorker --access-logfile - --error-logfile - app.main:app"
command_user="aprsbox:aprsbox"
directory="/opt/aprsbox/app"
pidfile="/run/aprsbox-web.pid"
command_background="yes"
output_log="/opt/aprsbox/logs/aprsbox-web.log"
error_log="/opt/aprsbox/logs/aprsbox-web.error.log"
retry="TERM/30/KILL/5"

export APRSBOX_ENV="production"
export APRSBOX_INSTALL_ROOT="/opt/aprsbox"
export APRSBOX_DB_PATH="/opt/aprsbox/data/aprsbox.db"
export APRSBOX_LOG_DIR="/opt/aprsbox/logs"
export PYTHONPATH="/opt/aprsbox/app"
export APRSBOX_CORE_HOST="127.0.0.1"
export APRSBOX_CORE_PORT="18081"

depend() {
    need localmount
    after aprsbox-core
    use net
}
