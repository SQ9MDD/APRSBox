[Unit]
Description=APRSBox Web
After=local-fs.target network-online.target aprsbox-core.service aprsbox-http-redirect.service
Wants=network-online.target aprsbox-http-redirect.service

[Service]
Type=simple
User=aprsbox
Group=aprsbox
WorkingDirectory=/opt/aprsbox/app
Environment=APRSBOX_ENV=production
Environment=APRSBOX_INSTALL_ROOT=/opt/aprsbox
Environment=APRSBOX_DB_PATH=/opt/aprsbox/data/aprsbox.db
Environment=APRSBOX_LOG_DIR=/opt/aprsbox/logs
Environment=PYTHONPATH=/opt/aprsbox/app
Environment=APRSBOX_PRIVILEGED_RUNNER=sudo -n
Environment=APRSBOX_CORE_HOST=127.0.0.1
Environment=APRSBOX_CORE_PORT=18081
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/opt/aprsbox/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 443 --ssl-certfile /opt/aprsbox/data/ssl/aprsbox.crt --ssl-keyfile /opt/aprsbox/data/ssl/aprsbox.key --access-log
Restart=on-failure
RestartSec=2
StandardOutput=append:/opt/aprsbox/logs/aprsbox-web.log
StandardError=append:/opt/aprsbox/logs/aprsbox-web.error.log

[Install]
WantedBy=multi-user.target
